# ============================================================
# TeaVerse 프로젝트 설정 (예시)
# ------------------------------------------------------------
# 이 파일을 config/project.env 로 복사한 뒤 실제 값을 채우세요.
#   cp config/project.env.example config/project.env
# config/project.env 는 .gitignore 처리되어 커밋되지 않습니다.
#
# 스크립트(infra/*.sh, scripts/*.mjs)와 배포는 이 값을 사용합니다.
# 계정 번호는 aws sts get-caller-identity 로 자동 조회되므로 적지 않습니다.
# ============================================================

# --- AWS ---
AWS_REGION=us-east-1

# --- 프론트엔드 배포(S3) ---
# 비우면 배포 스크립트가 teaverse-web-<ACCOUNT_ID>-<REGION> 으로 자동 생성
S3_BUCKET=

# --- Cognito (infra/cognito_setup.sh 실행 후 채워짐) ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# --- AgentCore Runtime ---
# 실행 역할: Bedrock InvokeModel + 로그 권한을 가진 역할의 ARN(또는 이름).
# 계정에 맞게 준비하세요. (예: 직접 만든 teaverse-agentcore-role)
AGENTCORE_ROLE_ARN=
AGENTCORE_ROLE_NAME=
AGENTCORE_RUNTIME_NAME=teaverse_backend
# 배포 후 채워짐
AGENTCORE_RUNTIME_ARN=

# --- 데모 계정 (Cognito에 생성할 계정) ---
# 공개 배포 시 반드시 변경하세요. 예시 값입니다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-Admin@1
USER1_USERNAME=user01
USER1_PASSWORD=ChangeMe-User01@1
USER2_USERNAME=user02
USER2_PASSWORD=ChangeMe-User02@1

# --- 배포 결과 URL (배포 후 자동 기록/수동 입력) ---
SITE_URL=
