# 프론트엔드 환경변수 예시. 실제 값은 .env.local 에 넣으세요(커밋 금지).
# 비워두면 개발용 목(mock) 인증으로 동작합니다.

VITE_API_BASE=/api
VITE_DATA_BASE=/data

VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# AgentCore Runtime (설정 시 챗봇이 이 런타임을 직접 호출; 미설정 시 /api 로컬 백엔드)
VITE_AGENTCORE_REGION=us-east-1
VITE_AGENTCORE_ARN=
